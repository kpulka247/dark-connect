{
  "name": "dark-connect",
  "version": "2.8.1",
  "type": "module",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "webpack --mode development && node --test test/e2e/*.test.js",
    "sweep": "webpack --mode development && node scripts/sweep.mjs",
    "colors": "webpack --mode development && node scripts/audit-colors.mjs",
    "lint": "stylelint \"src/**/*.css\" && node scripts/check-css.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/darkconnect-firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graphics": "node scripts/build-graphics.mjs",
    "screenshots": "webpack --mode development && node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.2",
    "@semantic-release/npm": "^12.0.1",
    "conventional-changelog": "^6.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "1.65.0",
    "postcss": "^8.5.3",
    "postcss-selector-parser": "^7.1.0",
    "prettier": "3.6.2",
    "semantic-release": "^24.2.3",
    "sharp": "^0.34.5",
    "stylelint": "16.23.1",
    "web-ext": "8.10.0",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.0.4",
    "zip-webpack-plugin": "^4.0.3"
  }
}
